# Supabase (Project settings -> API). Either naming works; next.config.ts maps them.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
SUPABASE_SERVICE_KEY=<service role key, server only, never exposed to the browser>

# OpenAI: receipt OCR (Expenses -> "Scan receipt"). Server only.
OPENAI_API_KEY=sk-...   # OPENAI_KEY also works
# Optional: vision-capable model used for OCR. Defaults to gpt-5-mini.
OPENAI_OCR_MODEL=gpt-5-mini

# 32 random bytes, base64. Encrypts the stored third-party logins (Log-in vault).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Set to true only after configuring an email provider (SMTP) in Supabase Auth.
# false (default): sign-up signs people in immediately and no emails are promised.
EMAIL_ENABLED=false

# Shared secret for the scheduled FX refresh route (/api/cron/fx?key=...). Optional.
CRON_SECRET=

# Public site URL used in emails and invoice links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
